<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="/styles.css" />
    <title>Sök ärenden – SecureHub</title>
  </head>
  <body>
    <header>
      <nav aria-label="Huvudnavigation">
        <a href="/dashboard">SecureHub</a>
        <a href="/dashboard">Översikt</a>
        <a href="/search">Sök ärenden</a>
        <a href="/profile">Profil</a>
        <% if (user.role === 'admin') { %>
          <a href="/admin/users">Användare</a>
        <% } %>
        <span class="nav-user"><%= user.display_name %> (<%= user.role %>)</span>
        <form method="post" action="/logout" class="nav-form">
          <button type="submit">Logga ut</button>
        </form>
      </nav>
    </header>
    <main>
      <h1>Sök ärenden</h1>
      <form method="get" action="/search">
        <label for="q">Sökord</label>
        <input id="q" name="q" value="<%= query %>" type="search" />
        <button type="submit">Sök</button>
      </form>
      <h2>Resultat</h2>
      <% if (tickets.length === 0) { %>
        <p>Inga ärenden hittades.</p>
      <% } else { %>
        <ul>
          <% tickets.forEach((ticket) => { %>
            <li><a href="/tickets/<%= ticket.id %>"><%= ticket.title %></a></li>
          <% }) %>
        </ul>
      <% } %>
    </main>
  </body>
</html>
