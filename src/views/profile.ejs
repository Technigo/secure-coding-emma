<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="/styles.css" />
    <title>Profil – SecureHub</title>
  </head>
  <body>
    <header>
      <nav aria-label="Huvudnavigation">
        <a href="/dashboard">SecureHub</a>
        <a href="/dashboard">Översikt</a>
        <a href="/search">Sök ärenden</a>
        <a href="/profile">Profil</a>
        <% if (user.role === 'admin') { %>
          <a href="/admin/users">Användare</a>
        <% } %>
        <span class="nav-user"><%= user.display_name %> (<%= user.role %>)</span>
        <form method="post" action="/logout" class="nav-form">
          <button type="submit">Logga ut</button>
        </form>
      </nav>
    </header>
    <main>
      <h1>Profil</h1>
      <% if (error) { %>
        <p role="alert"><%= error %></p>
      <% } %>
      <dl>
        <dt>E-postadress</dt>
        <dd><%= user.email %></dd>
        <dt>Roll</dt>
        <dd><%= user.role %></dd>
      </dl>
      <form method="post" action="/profile">
        <label for="display_name">Visningsnamn</label>
        <input id="display_name" name="display_name" value="<%= user.display_name %>" required />
        <button type="submit">Spara profil</button>
      </form>
    </main>
  </body>
</html>
