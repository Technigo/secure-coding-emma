<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="/styles.css" />
    <title>Användare – SecureHub</title>
  </head>
  <body>
    <header>
      <nav aria-label="Huvudnavigation">
        <a href="/dashboard">SecureHub</a>
        <a href="/dashboard">Översikt</a>
        <a href="/search">Sök ärenden</a>
        <a href="/profile">Profil</a>
        <a href="/admin/users">Användare</a>
        <span class="nav-user"><%= user.display_name %> (<%= user.role %>)</span>
        <form method="post" action="/logout" class="nav-form">
          <button type="submit">Logga ut</button>
        </form>
      </nav>
    </header>
    <main>
      <h1>Användare</h1>
      <table>
        <thead>
          <tr><th>E-postadress</th><th>Visningsnamn</th><th>Roll</th></tr>
        </thead>
        <tbody>
          <% users.forEach((listedUser) => { %>
            <tr>
              <td><%= listedUser.email %></td>
              <td><%= listedUser.display_name %></td>
              <td><%= listedUser.role %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </main>
  </body>
</html>
